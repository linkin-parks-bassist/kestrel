v1.0

.INFO
description: "Resonant band-pass filter with center frequency and resonance controls."
keywords: {"band pass", "bandpass", "band-pass", "center frequency", "resonance"}
instruments: {"bass"}
types: {"filter"}
name: "SVF Band Pass"

.PARAMETERS
cutoff: (name: "Center", default: 1000, min: 30, max: 5000, units: "Hz", scale: "logarithmic")
Q: (name: "Resonance", default: 1, min: 0.5, max: 2)

.CODE
svf c0 [2*sin(pi*cutoff/sample_rate)] [1/Q]
svf_band c1
mul c1 [1/Q] c0
