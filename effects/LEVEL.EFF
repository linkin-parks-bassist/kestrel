v1.0

.INFO
description: "Clean level attenuation without changing the signal shape."
keywords: {"level", "gain", "volume", "attenuation", "clean"}
instruments: {"bass"}
types: {"utility"}
name: "Clean Level"

.PARAMETERS
level: (name: "Level", default: 0, min: -24, max: 0, units: "dB")

.CODE
mul c0 [10^(level/20)] c0
