v1.0

.INFO
description: "Invert signal polarity with adjustable output attenuation."
keywords: {"polarity", "phase invert", "invert", "level"}
instruments: {"bass"}
types: {"utility"}
name: "Phase Invert"

.PARAMETERS
level: (name: "Level", default: 0, min: -24, max: 0, units: "dB")

.CODE
mul c0 [-10^(level/20)] c0
