v1.0

.INFO
name: "Talking Vowel"

.PARAMETERS
mouth: (name: "Mouth", default: 0.5, min: 0, max: 1)
Q: (name: "Pronunciation", default: 2, min: 1, max: 3)

.CODE
svf c0 [2*sin(pi*(100+400*mouth)/sample_rate)] [1/Q]
svf_band c1
mul c1 [2/Q] c2
svf c0 [2*sin(pi*(1400-1000*mouth)/sample_rate)] [1/Q]
svf_band c3
madd c3 [2/Q] c2 c4
add c0 c4 c0
