v1.0

.INFO
name: "Talking Vowel"

.PARAMETERS
mouth: (name: "Mouth", default: 0.5, min: 0, max: 1)
Q: (name: "Pronunciation", default: 2, min: 1, max: 3)

.CODE
svf c0 [2*sin(pi*(350+450*mouth)/sample_rate)] [1/Q]
svf_band c1
mul c1 [0.5/Q] c2
svf c0 [2*sin(pi*(2200-1000*mouth)/sample_rate)] [1/Q]
svf_band c3
madd c3 [0.5/Q] c2 c0
