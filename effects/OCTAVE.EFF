v1.0

.INFO
description: "Full-wave rectification creates octave-like harmonics, with DC removal and level control."
keywords: {"octave", "rectifier", "full wave", "harmonics", "DC removal"}
instruments: {"bass"}
types: {"octave", "distortion"}
name: "Octave Rectifier"

.PARAMETERS
level: (name: "Level", default: -6, min: -24, max: 0, units: "dB")

.CODE
mul c0 [0.5] c1
abs c1 c1
svf c1 [2*sin(pi*30/sample_rate)] [sqrt(2)]
svf_high c2
mul c2 [2*10^(level/20)] c0
