v1.0

.INFO
description: "Two-pole resonant high-pass filter with cutoff and resonance controls."
keywords: {"high pass", "highpass", "high-pass", "cutoff", "resonance", "two pole"}
instruments: {"bass"}
types: {"filter"}
name: "SVF High Pass"

.PARAMETERS
cutoff: (name: "Cutoff", default: 1000, min: 30, max: 5000, units: "Hz", scale: "logarithmic")
Q: (name: "Resonance", default: 1/sqrt(2), min: 0.5, max: 2)

.CODE
svf c0 [2*sin(pi*cutoff/sample_rate)] [1/Q]
svf_high c0
