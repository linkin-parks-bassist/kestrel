v1.0

.INFO
description: "Hard clipping with adjustable input drive and clipping ceiling."
keywords: {"hard clip", "clipping", "drive", "ceiling", "distortion"}
instruments: {"bass"}
types: {"distortion"}
name: "Hard Clip"

.PARAMETERS
drive: (name: "Drive", default: 6, min: 0, max: 24, units: "dB")
ceiling: (name: "Ceiling", default: 0.5, min: 0.1, max: 1)

.CODE
mul c0 [10^(drive/20)] c1
clamp c1 [-ceiling] [ceiling] c0
