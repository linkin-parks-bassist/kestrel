v1.0

.INFO
description: "Four-pole low-pass filtering from two cascaded sections, with adjustable cutoff."
keywords: {"low pass", "lowpass", "low-pass", "four pole", "cascade", "cutoff"}
instruments: {"bass"}
types: {"filter"}
name: "SVF Low Pass 4"

.PARAMETERS
cutoff: (name: "Cutoff", default: 1500, min: 50, max: 3500, units: "Hz", scale: "logarithmic")

.CODE
svf c0 [2*sin(pi*cutoff/sample_rate)] [sqrt(2)]
svf_low c1
svf c1 [2*sin(pi*cutoff/sample_rate)] [sqrt(2)]
svf_low c0
